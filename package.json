{
  "name": "design-system",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "test": "turbo run test",
    "storybook": "pnpm --filter @jocoding-ax-partners/storybook run storybook",
    "build-storybook": "pnpm --filter @jocoding-ax-partners/storybook run build-storybook",
    "extract-stories": "tsx scripts/extract-heroui-stories.ts",
    "prepare": "husky",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "turbo run build --filter='./packages/*' && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@nijesmik/eslint-config": "^0.1.2",
    "@types/node": "^24.13.3",
    "eslint": "^9.39.5",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "postcss": "^8.5.28",
    "postcss-cli": "^11.0.1",
    "postcss-import": "^16.2.0",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.7.4",
    "tsx": "^4.23.13",
    "turbo": "^2.10.12",
    "typescript": "5.9.2"
  },
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=24"
  },
  "pnpm": {
    "overrides": {
      "css-tree": "3.1.0",
      "@csstools/css-syntax-patches-for-csstree": "1.0.25"
    }
  }
}
