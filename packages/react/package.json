{
  "name": "@demodev-ui/react",
  "version": "2.4.3",
  "type": "module",
  "scripts": {
    "build": "postcss src/styles/index.css -o dist/styles/index.css && cp src/styles/index.d.ts dist/styles/index.d.ts",
    "lint-staged": "lint-staged"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts,mts,cts,jsx,tsx}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.css": [
      "prettier --write",
      "stylelint --fix"
    ]
  },
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    "./styles": {
      "types": "./src/styles/index.d.ts",
      "default": "./src/styles/index.css"
    }
  },
  "publishConfig": {
    "exports": {
      "./styles": {
        "types": "./dist/styles/index.d.ts",
        "default": "./dist/styles/index.css"
      }
    }
  },
  "files": [
    "dist",
    "llms.txt"
  ],
  "peerDependencies": {
    "@heroui/react": "catalog:",
    "@heroui/styles": "catalog:",
    "tailwindcss": "^4"
  },
  "devDependencies": {
    "@demodev-ui/core": "workspace:^",
    "@heroui/react": "catalog:",
    "@heroui/styles": "catalog:",
    "@nijesmik/stylelint-config": "^0.1.0",
    "@tsconfig/create-react-app": "^2.0.10",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "stylelint": "^16.26.1",
    "tailwindcss": "^4.1.18"
  }
}
