{
  "name": "@demodev-ui/react",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "lint-staged": "lint-staged"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts,mts,cts,jsx,tsx}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.css": [
      "prettier --write",
      "stylelint --fix"
    ]
  },
  "sideEffects": ["*.css"],
  "exports": {
    ".": "./src/index.ts",
    "./styles": {
      "types": "./src/styles/index.d.ts",
      "default": "./src/styles/index.css"
    }
  },
  "dependencies": {
    "@demodev-ui/core": "workspace:^"
  },
  "peerDependencies": {
    "@heroui/react": "catalog:",
    "@heroui/styles": "catalog:",
    "tailwindcss": "^4"
  },
  "devDependencies": {
    "@heroui/react": "catalog:",
    "@heroui/styles": "catalog:",
    "@tsconfig/create-react-app": "^2.0.10",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "tailwindcss": "^4.1.18"
  }
}
